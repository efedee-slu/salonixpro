{
  "crons": [
    {
      "path": "/api/cron/daily-cleanup?secret=${CRON_SECRET}",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/send-reminders?secret=${CRON_SECRET}",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/process-deposits?secret=${CRON_SECRET}",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/send-review-requests?secret=${CRON_SECRET}",
      "schedule": "0 */1 * * *"
    },
    {
      "path": "/api/cron/extend-recurring-series?secret=${CRON_SECRET}",
      "schedule": "0 2 * * 0"
    },
    {
      "path": "/api/cron/expire-waitlist?secret=${CRON_SECRET}",
      "schedule": "0 3 * * *"
    }
  ]
}
